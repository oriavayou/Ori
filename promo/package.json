{
  "name": "promo-video",
  "private": true,
  "type": "module",
  "description": "Renders the promo video: branded scene + a capture of the real site",
  "scripts": {
    "render": "node tools/render.mjs",
    "site": "node tools/site-promo.mjs",
    "draft": "node tools/render.mjs --scale 0.5",
    "fonts": "node tools/build-fonts.mjs",
    "setup": "npm install && playwright install chromium && node tools/vendor-libs.mjs",
    "scroll": "node tools/site-promo.mjs --url \"site/index.html?render=1\" --intro none --outro none --no-overlay --hold-top 1.4 --scroll 17 --hold-end 1.6 --out promo/out/promo-scroll-9x16.mp4",
    "vendor": "node tools/vendor-libs.mjs",
    "artifact": "node tools/build-artifact.mjs"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.56.1"
  }
}
