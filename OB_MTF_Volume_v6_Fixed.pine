//@version=6
indicator("XAUUSD MTF Order Blocks + Tick Volume [v6 Fixed]", overlay=true, max_boxes_count=500, max_labels_count=100, max_bars_back=1000)

// v6 fixes over v5:
// 1. FVG is now measured correctly: the impulse candle is bar [1] and the gap is
//    confirmed by bar [0] (low[0] > high[2]). v5 required the impulse candle
//    itself to gap over the candle two bars back, which almost never happens on a
//    single impulse candle, so most OBs were never detected.
// 2. All ta.* calls are made on every bar. Pine v6 evaluates `and` lazily, so
//    ta.highest()/ta.lowest() inside an `and` chain were computed on a broken
//    history and the break-of-structure test returned wrong values.
// 3. One box per 30m OB (no stacked duplicates). A weak-volume box is upgraded
//    in place when a strong-volume 15m confirmation appears later.
// 4. Default transparencies are visible on mobile (v5 used 94-98%, which made
//    weak, touched and stopped zones practically invisible).
// 5. Optional debug mode draws every raw 30m / 15m OB that was detected.
// 6. Alerts fire only when a NEW zone is drawn, not on every bar.

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
string GROUP_OB = "Order Block Detection"
int atrLen = input.int(14, "ATR length", minval=2, group=GROUP_OB)
int structureLen = input.int(5, "Break of structure lookback", minval=2, maxval=30, group=GROUP_OB)
int searchLen = input.int(8, "Search last opposite candle", minval=1, maxval=30, group=GROUP_OB)
float impulseATR = input.float(0.80, "Impulse body / ATR", minval=0.1, step=0.05, group=GROUP_OB)
float minBodyPct = input.float(0.55, "Minimum body / candle range", minval=0.1, maxval=1.0, step=0.05, group=GROUP_OB)
bool requireFVG = input.bool(true, "Require FVG after impulse candle", group=GROUP_OB)
int maxAgeBars = input.int(100, "Maximum OB age (bars of its own timeframe)", minval=5, maxval=1000, group=GROUP_OB)

string GROUP_VOL = "Volume Filter (chart symbol)"
int volLen = input.int(20, "Volume average length", minval=2, group=GROUP_VOL)
float volMultiplier = input.float(1.50, "High-volume threshold", minval=1.0, step=0.05, group=GROUP_VOL)
int volumeWindow = input.int(3, "Volume scan window around impulse", minval=1, maxval=5, group=GROUP_VOL)

string GROUP_MTF = "Multi-timeframe Confirmation"
float nearATR = input.float(0.25, "Allowed distance between OBs (30m ATR multiple)", minval=0.0, step=0.05, group=GROUP_MTF)

string GROUP_SESSIONS = "Valid OB Creation Sessions"
bool restrictToSessions = input.bool(true, "Only accept OB source candles during these sessions", group=GROUP_SESSIONS,
     tooltip="Only the opposite-colour OB source candle must fall inside an enabled session. The confirming impulse candle may occur outside session hours.")
bool useTokyo = input.bool(true, "Tokyo", inline="TOK", group=GROUP_SESSIONS)
string tokyoSession = input.session("0900-1500", "Hours", inline="TOK", group=GROUP_SESSIONS)
bool useLondon = input.bool(true, "London", inline="LON", group=GROUP_SESSIONS)
string londonSession = input.session("0830-1630", "Hours", inline="LON", group=GROUP_SESSIONS)
bool useNewYork = input.bool(true, "New York", inline="NY", group=GROUP_SESSIONS)
string newYorkSession = input.session("0930-1600", "Hours", inline="NY", group=GROUP_SESSIONS)

string GROUP_DRAW = "Display"
int maxZones = input.int(40, "Maximum zones to keep", minval=1, maxval=150, group=GROUP_DRAW)
int maxRecordsPerTF = input.int(80, "Maximum OB records per timeframe", minval=10, maxval=250, group=GROUP_DRAW)
int strongOpacity = input.int(70, "Strong-volume box transparency", minval=0, maxval=100, group=GROUP_DRAW)
int weakOpacity = input.int(86, "Weak-volume box transparency", minval=0, maxval=100, group=GROUP_DRAW)
int touchedOpacity = input.int(90, "Touched box transparency", minval=0, maxval=100, group=GROUP_DRAW)
int stoppedOpacity = input.int(94, "Invalidated box transparency", minval=0, maxval=100, group=GROUP_DRAW)
bool showStatus = input.bool(true, "Show diagnostic status panel", group=GROUP_DRAW)

string GROUP_DEBUG = "Debug"
bool showRaw30 = input.bool(false, "Show every raw 30m OB (dashed)", group=GROUP_DEBUG)
bool showRaw15 = input.bool(false, "Show every raw 15m OB (dotted)", group=GROUP_DEBUG)

// -----------------------------------------------------------------------------
// OB scanner, evaluated independently in each timeframe context.
// The impulse candle is the last CLOSED bar [1]; the current bar [0] confirms
// the FVG (bull: low[0] > high[2], bear: high[0] < low[2]). The event is
// emitted on bar [0]. The OB source candle must be in-session.
// -----------------------------------------------------------------------------
f_scanOB() =>
    bool inTokyo = useTokyo and not na(time(timeframe.period, tokyoSession, "Asia/Tokyo"))
    bool inLondon = useLondon and not na(time(timeframe.period, londonSession, "Europe/London"))
    bool inNewYork = useNewYork and not na(time(timeframe.period, newYorkSession, "America/New_York"))
    bool inAllowedSession = inTokyo or inLondon or inNewYork

    // Every ta.* call is unconditional (v6 lazy `and` would otherwise skip bars).
    float atrNow = ta.atr(atrLen)
    float avgVol = ta.sma(volume, volLen)
    float volPeak = ta.highest(volume, volumeWindow)
    float structHigh = ta.highest(high, structureLen)
    float structLow = ta.lowest(low, structureLen)

    float body = math.abs(close - open)
    float candleRange = math.max(high - low, syminfo.mintick)
    float bodyRatio = body / candleRange

    // Impulse = bar [1]. Structure is measured on the bars BEFORE it ([2] and older).
    bool bigBody = not na(atrNow[1]) and body[1] >= atrNow[1] * impulseATR and bodyRatio[1] >= minBodyPct
    bool bullImpulse = close[1] > open[1] and bigBody and not na(structHigh[2]) and close[1] > structHigh[2]
    bool bearImpulse = close[1] < open[1] and bigBody and not na(structLow[2]) and close[1] < structLow[2]
    if requireFVG
        bullImpulse := bullImpulse and low > high[2]
        bearImpulse := bearImpulse and high < low[2]

    // Volume average is taken from bars before the impulse; the peak covers the
    // impulse candle and its neighbours.
    bool volumePass = not na(avgVol[2]) and not na(volPeak) and volPeak >= avgVol[2] * volMultiplier

    int src = na
    int dir = 0
    if bullImpulse
        dir := 1
        for i = 2 to searchLen + 1
            if na(src) and close[i] < open[i] and (not restrictToSessions or inAllowedSession[i])
                src := i
    else if bearImpulse
        dir := -1
        for i = 2 to searchLen + 1
            if na(src) and close[i] > open[i] and (not restrictToSessions or inAllowedSession[i])
                src := i

    int srcTime = na
    int impulseTime = na
    float srcBottom = na
    float srcTop = na
    int outDir = 0
    bool outVol = false
    if not na(src)
        srcTime := time[src]
        impulseTime := time[1]
        srcBottom := math.min(open[src], close[src])
        srcTop := math.max(open[src], close[src])
        outDir := dir
        outVol := volumePass
    [srcTime, impulseTime, srcBottom, srcTop, outDir, outVol]

// -----------------------------------------------------------------------------
// Storage helpers
// -----------------------------------------------------------------------------
f_addRecord(array<int> times, array<int> impulseTimes, array<float> bottoms, array<float> tops,
            array<int> directions, array<bool> volumePasses, array<bool> touched, array<bool> broken,
            int srcTime, int impulseTime, float bottom, float top, int direction, bool volumePass, int maxRecords) =>
    bool added = false
    if not na(srcTime) and not na(impulseTime) and not na(bottom) and not na(top) and direction != 0
        bool exists = false
        if array.size(times) > 0
            for k = 0 to array.size(times) - 1
                if array.get(times, k) == srcTime
                    exists := true
        if not exists
            array.push(times, srcTime)
            array.push(impulseTimes, impulseTime)
            array.push(bottoms, bottom)
            array.push(tops, top)
            array.push(directions, direction)
            array.push(volumePasses, volumePass)
            array.push(touched, false)
            array.push(broken, false)
            added := true
            while array.size(times) > maxRecords
                array.shift(times)
                array.shift(impulseTimes)
                array.shift(bottoms)
                array.shift(tops)
                array.shift(directions)
                array.shift(volumePasses)
                array.shift(touched)
                array.shift(broken)
    added

f_updateRecords(array<int> impulseTimes, array<float> bottoms, array<float> tops,
                array<int> directions, array<bool> touched, array<bool> broken,
                int tfSeconds, int ageBars) =>
    if array.size(impulseTimes) > 0
        for i = 0 to array.size(impulseTimes) - 1
            int bornAt = array.get(impulseTimes, i)
            float bottom = array.get(bottoms, i)
            float top = array.get(tops, i)
            int direction = array.get(directions, i)
            bool wasTouched = array.get(touched, i)
            bool wasBroken = array.get(broken, i)
            if not na(bornAt) and time > bornAt and not wasTouched and not wasBroken
                if high >= bottom and low <= top
                    wasTouched := true
                if direction == 1 and close < bottom
                    wasBroken := true
                if direction == -1 and close > top
                    wasBroken := true
            if not na(bornAt) and time - bornAt > ageBars * tfSeconds * 1000
                wasBroken := true
            array.set(touched, i, wasTouched)
            array.set(broken, i, wasBroken)

f_recordUsable(array<int> impulseTimes, array<bool> touched, array<bool> broken, int tfSeconds, int ageBars, int index) =>
    int bornAt = array.get(impulseTimes, index)
    bool ageOK = not na(bornAt) and time - bornAt <= ageBars * tfSeconds * 1000
    ageOK and not array.get(touched, index) and not array.get(broken, index)

f_countUsable(array<int> impulseTimes, array<bool> touched, array<bool> broken, int tfSeconds, int ageBars) =>
    int count = 0
    if array.size(impulseTimes) > 0
        for i = 0 to array.size(impulseTimes) - 1
            if f_recordUsable(impulseTimes, touched, broken, tfSeconds, ageBars, i)
                count += 1
    count

f_near(float lowA, float highA, float lowB, float highB, float tolerance) =>
    bool valid = not na(lowA) and not na(highA) and not na(lowB) and not na(highB)
    float gap = valid ? math.max(0.0, math.max(lowA, lowB) - math.min(highA, highB)) : na
    valid and gap <= tolerance

f_hasId(array<string> ids, string id) =>
    bool found = false
    if array.size(ids) > 0
        for i = 0 to array.size(ids) - 1
            if array.get(ids, i) == id
                found := true
    found

f_indexOf(array<string> ids, string id) =>
    int idx = -1
    if array.size(ids) > 0
        for i = 0 to array.size(ids) - 1
            if idx == -1 and array.get(ids, i) == id
                idx := i
    idx

f_rawBox(array<box> store, int srcTime, int impulseTime, float bottom, float top, int direction, int tfSeconds, string tfText, string lineStyle) =>
    color base = direction == 1 ? color.teal : color.red
    box bx = box.new(left=srcTime, top=top, right=impulseTime + 20 * tfSeconds * 1000, bottom=bottom, xloc=xloc.bar_time,
         bgcolor=color.new(base, 100), border_color=color.new(base, 30), border_width=1, border_style=lineStyle,
         text=tfText, text_color=color.new(base, 20), text_size=size.tiny, text_halign=text.align_left, text_valign=text.align_top)
    array.push(store, bx)
    while array.size(store) > 120
        box.delete(array.shift(store))

// -----------------------------------------------------------------------------
// Collect 30m state directly and ALL 15m / 10m / 5m intrabars.
// Keep this indicator on a 30-minute chart so these are all lower TF arrays.
// -----------------------------------------------------------------------------
[time30State, impulse30State, bottom30State, top30State, dir30State, vol30State] = f_scanOB()
[t15Arr, imp15Arr, bot15Arr, top15Arr, dir15Arr, vol15Arr] = request.security_lower_tf(syminfo.tickerid, "15", f_scanOB(), ignore_invalid_timeframe=true)
[t10Arr, imp10Arr, bot10Arr, top10Arr, dir10Arr, vol10Arr] = request.security_lower_tf(syminfo.tickerid, "10", f_scanOB(), ignore_invalid_timeframe=true)
[t5Arr, imp5Arr, bot5Arr, top5Arr, dir5Arr, vol5Arr] = request.security_lower_tf(syminfo.tickerid, "5", f_scanOB(), ignore_invalid_timeframe=true)

var array<int> times30 = array.new<int>()
var array<int> impulses30 = array.new<int>()
var array<float> bottoms30 = array.new<float>()
var array<float> tops30 = array.new<float>()
var array<int> directions30 = array.new<int>()
var array<bool> volumes30 = array.new<bool>()
var array<bool> touched30 = array.new<bool>()
var array<bool> broken30 = array.new<bool>()

var array<int> times15 = array.new<int>()
var array<int> impulses15 = array.new<int>()
var array<float> bottoms15 = array.new<float>()
var array<float> tops15 = array.new<float>()
var array<int> directions15 = array.new<int>()
var array<bool> volumes15 = array.new<bool>()
var array<bool> touched15 = array.new<bool>()
var array<bool> broken15 = array.new<bool>()

var array<int> times10 = array.new<int>()
var array<int> impulses10 = array.new<int>()
var array<float> bottoms10 = array.new<float>()
var array<float> tops10 = array.new<float>()
var array<int> directions10 = array.new<int>()
var array<bool> volumes10 = array.new<bool>()
var array<bool> touched10 = array.new<bool>()
var array<bool> broken10 = array.new<bool>()

var array<int> times5 = array.new<int>()
var array<int> impulses5 = array.new<int>()
var array<float> bottoms5 = array.new<float>()
var array<float> tops5 = array.new<float>()
var array<int> directions5 = array.new<int>()
var array<bool> volumes5 = array.new<bool>()
var array<bool> touched5 = array.new<bool>()
var array<bool> broken5 = array.new<bool>()

var array<box> rawBoxes = array.new<box>()
var int total30 = 0
var int total15 = 0

if not na(time30State)
    bool added30 = f_addRecord(times30, impulses30, bottoms30, tops30, directions30, volumes30, touched30, broken30,
         time30State, impulse30State, bottom30State, top30State, dir30State, vol30State, maxRecordsPerTF)
    if added30
        total30 += 1
        if showRaw30
            f_rawBox(rawBoxes, time30State, impulse30State, bottom30State, top30State, dir30State, 1800, "30m", line.style_dashed)

if array.size(t15Arr) > 0
    for i = 0 to array.size(t15Arr) - 1
        int srcT = array.get(t15Arr, i)
        if not na(srcT)
            bool added15 = f_addRecord(times15, impulses15, bottoms15, tops15, directions15, volumes15, touched15, broken15,
                 srcT, array.get(imp15Arr, i), array.get(bot15Arr, i), array.get(top15Arr, i), array.get(dir15Arr, i), array.get(vol15Arr, i), maxRecordsPerTF)
            if added15
                total15 += 1
                if showRaw15
                    f_rawBox(rawBoxes, srcT, array.get(imp15Arr, i), array.get(bot15Arr, i), array.get(top15Arr, i), array.get(dir15Arr, i), 900, "15m", line.style_dotted)

if array.size(t10Arr) > 0
    for i = 0 to array.size(t10Arr) - 1
        int srcT = array.get(t10Arr, i)
        if not na(srcT)
            f_addRecord(times10, impulses10, bottoms10, tops10, directions10, volumes10, touched10, broken10,
                 srcT, array.get(imp10Arr, i), array.get(bot10Arr, i), array.get(top10Arr, i), array.get(dir10Arr, i), array.get(vol10Arr, i), maxRecordsPerTF)

if array.size(t5Arr) > 0
    for i = 0 to array.size(t5Arr) - 1
        int srcT = array.get(t5Arr, i)
        if not na(srcT)
            f_addRecord(times5, impulses5, bottoms5, tops5, directions5, volumes5, touched5, broken5,
                 srcT, array.get(imp5Arr, i), array.get(bot5Arr, i), array.get(top5Arr, i), array.get(dir5Arr, i), array.get(vol5Arr, i), maxRecordsPerTF)

// Update every saved OB independently.
f_updateRecords(impulses30, bottoms30, tops30, directions30, touched30, broken30, 1800, maxAgeBars)
f_updateRecords(impulses15, bottoms15, tops15, directions15, touched15, broken15, 900, maxAgeBars)
f_updateRecords(impulses10, bottoms10, tops10, directions10, touched10, broken10, 600, maxAgeBars)
f_updateRecords(impulses5, bottoms5, tops5, directions5, touched5, broken5, 300, maxAgeBars)

// -----------------------------------------------------------------------------
// Draw zones.
// Primary: 30m OB + nearby same-direction 15m OB (one box per 30m OB). Volume
// only changes the opacity; a weak box is upgraded if a strong pair appears.
// Fallback: a 15m OB with no 30m match, 15m volume OK, plus nearby fresh 10m
// AND 5m OBs (one box per 15m OB).
// -----------------------------------------------------------------------------
var array<box> zoneBoxes = array.new<box>()
var array<string> zoneKeys = array.new<string>()
var array<float> zoneTops = array.new<float>()
var array<float> zoneBottoms = array.new<float>()
var array<int> zoneDirections = array.new<int>()
var array<int> zoneCreatedTimes = array.new<int>()
var array<bool> zoneTouched = array.new<bool>()
var array<bool> zoneStopped = array.new<bool>()
var array<bool> zoneStrong = array.new<bool>()
var array<string> drawnIds = array.new<string>()

// Update already drawn rectangles. They fade on first retest and stop on invalidation.
if array.size(zoneBoxes) > 0
    for z = 0 to array.size(zoneBoxes) - 1
        box bx = array.get(zoneBoxes, z)
        bool wasTouched = array.get(zoneTouched, z)
        bool wasStopped = array.get(zoneStopped, z)
        float zTop = array.get(zoneTops, z)
        float zBottom = array.get(zoneBottoms, z)
        int zDir = array.get(zoneDirections, z)
        int zCreated = array.get(zoneCreatedTimes, z)
        color zBase = zDir == 1 ? color.teal : color.red
        if not wasStopped and time > zCreated
            if not wasTouched and high >= zBottom and low <= zTop
                array.set(zoneTouched, z, true)
                box.set_bgcolor(bx, color.new(zBase, touchedOpacity))
                box.set_border_color(bx, color.new(zBase, 60))
            bool invalid = (zDir == 1 and close < zBottom) or (zDir == -1 and close > zTop)
            if invalid
                array.set(zoneStopped, z, true)
                box.set_extend(bx, extend.none)
                box.set_right(bx, time)
                box.set_bgcolor(bx, color.new(zBase, stoppedOpacity))
                box.set_border_color(bx, color.new(zBase, 80))

bool chartIs30m = timeframe.in_seconds() == 1800
float atrForDistance = ta.atr(14)
float allowedGap = atrForDistance * nearATR
int primaryPairs = 0
int fallbackTriples = 0
int newPrimary = 0
int newFallback = 0

if chartIs30m and array.size(times15) > 0
    for j = 0 to array.size(times15) - 1
        if f_recordUsable(impulses15, touched15, broken15, 900, maxAgeBars, j)
            int dir15 = array.get(directions15, j)
            float low15 = array.get(bottoms15, j)
            float high15 = array.get(tops15, j)
            bool matched30ForThis15 = false

            // Primary 30m + 15m pairing. Search ALL stored 30m candidates.
            if array.size(times30) > 0
                for k = 0 to array.size(times30) - 1
                    bool usable30 = f_recordUsable(impulses30, touched30, broken30, 1800, maxAgeBars, k)
                    if usable30 and array.get(directions30, k) == dir15 and f_near(array.get(bottoms30, k), array.get(tops30, k), low15, high15, allowedGap)
                        matched30ForThis15 := true
                        primaryPairs += 1
                        int src30 = array.get(times30, k)
                        string zoneId = "P|" + str.tostring(src30)
                        bool strongVolume = array.get(volumes30, k) and array.get(volumes15, j)
                        color base = dir15 == 1 ? color.teal : color.red
                        int zIdx = f_indexOf(zoneKeys, zoneId)
                        if zIdx == -1 and not f_hasId(drawnIds, zoneId)
                            box newBox = box.new(left=src30, top=array.get(tops30, k), right=time, bottom=array.get(bottoms30, k), xloc=xloc.bar_time, extend=extend.right,
                                 bgcolor=color.new(base, strongVolume ? strongOpacity : weakOpacity), border_color=color.new(base, strongVolume ? 10 : 50), border_width=strongVolume ? 2 : 1,
                                 text=strongVolume ? "30m+15m · VOL OK" : "30m+15m · LOW VOL", text_color=color.new(base, 0), text_size=size.small,
                                 text_halign=text.align_left, text_valign=text.align_top)
                            array.push(zoneBoxes, newBox)
                            array.push(zoneKeys, zoneId)
                            array.push(zoneTops, array.get(tops30, k))
                            array.push(zoneBottoms, array.get(bottoms30, k))
                            array.push(zoneDirections, dir15)
                            array.push(zoneCreatedTimes, time)
                            array.push(zoneTouched, false)
                            array.push(zoneStopped, false)
                            array.push(zoneStrong, strongVolume)
                            array.push(drawnIds, zoneId)
                            newPrimary += 1
                        else if zIdx >= 0 and strongVolume and not array.get(zoneStrong, zIdx) and not array.get(zoneTouched, zIdx) and not array.get(zoneStopped, zIdx)
                            // Upgrade a weak box once a strong-volume pair confirms it.
                            box ub = array.get(zoneBoxes, zIdx)
                            box.set_bgcolor(ub, color.new(base, strongOpacity))
                            box.set_border_color(ub, color.new(base, 10))
                            box.set_border_width(ub, 2)
                            box.set_text(ub, "30m+15m · VOL OK")
                            array.set(zoneStrong, zIdx, true)

            // Fallback is evaluated per 15m OB: only if THIS 15m block has no 30m match.
            if not matched30ForThis15 and array.get(volumes15, j) and array.size(times10) > 0 and array.size(times5) > 0
                int match10 = na
                int match5 = na
                for k = 0 to array.size(times10) - 1
                    if na(match10) and f_recordUsable(impulses10, touched10, broken10, 600, maxAgeBars, k) and array.get(directions10, k) == dir15 and f_near(low15, high15, array.get(bottoms10, k), array.get(tops10, k), allowedGap)
                        match10 := k
                for k = 0 to array.size(times5) - 1
                    if na(match5) and f_recordUsable(impulses5, touched5, broken5, 300, maxAgeBars, k) and array.get(directions5, k) == dir15 and f_near(low15, high15, array.get(bottoms5, k), array.get(tops5, k), allowedGap)
                        match5 := k
                if not na(match10) and not na(match5)
                    fallbackTriples += 1
                    string tripleId = "F|" + str.tostring(array.get(times15, j))
                    if not f_hasId(drawnIds, tripleId)
                        color base = dir15 == 1 ? color.teal : color.red
                        box newBox = box.new(left=array.get(times15, j), top=high15, right=time, bottom=low15, xloc=xloc.bar_time, extend=extend.right,
                             bgcolor=color.new(base, strongOpacity), border_color=color.new(base, 10), border_width=2,
                             text="15m+10m+5m · VOL OK", text_color=color.new(base, 0), text_size=size.small,
                             text_halign=text.align_left, text_valign=text.align_top)
                        array.push(zoneBoxes, newBox)
                        array.push(zoneKeys, tripleId)
                        array.push(zoneTops, high15)
                        array.push(zoneBottoms, low15)
                        array.push(zoneDirections, dir15)
                        array.push(zoneCreatedTimes, time)
                        array.push(zoneTouched, false)
                        array.push(zoneStopped, false)
                        array.push(zoneStrong, true)
                        array.push(drawnIds, tripleId)
                        newFallback += 1

// Trim displayed zones; record arrays are independently capped per timeframe.
while array.size(zoneBoxes) > maxZones
    box.delete(array.shift(zoneBoxes))
    array.shift(zoneKeys)
    array.shift(zoneTops)
    array.shift(zoneBottoms)
    array.shift(zoneDirections)
    array.shift(zoneCreatedTimes)
    array.shift(zoneTouched)
    array.shift(zoneStopped)
    array.shift(zoneStrong)
while array.size(drawnIds) > maxZones * 8
    array.shift(drawnIds)

// -----------------------------------------------------------------------------
// Diagnostics
// -----------------------------------------------------------------------------
int fresh30Count = f_countUsable(impulses30, touched30, broken30, 1800, maxAgeBars)
int fresh15Count = f_countUsable(impulses15, touched15, broken15, 900, maxAgeBars)
int fresh10Count = f_countUsable(impulses10, touched10, broken10, 600, maxAgeBars)
int fresh5Count = f_countUsable(impulses5, touched5, broken5, 300, maxAgeBars)

var table status = table.new(position.top_right, 2, 10, border_width=1)
if barstate.islast and showStatus
    table.cell(status, 0, 0, "MTF OB STATUS v6", text_color=color.white, bgcolor=color.black)
    table.cell(status, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.black)
    table.cell(status, 0, 1, "Chart timeframe", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(status, 1, 1, chartIs30m ? "30m · OK" : "SWITCH TO 30m", text_color=chartIs30m ? color.lime : color.orange, bgcolor=color.new(color.black, 30))
    table.cell(status, 0, 2, "OBs detected (history)", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(status, 1, 2, "30m " + str.tostring(total30) + " | 15m " + str.tostring(total15), text_color=color.aqua, bgcolor=color.new(color.black, 30))
    table.cell(status, 0, 3, "Fresh now 30m / 15m", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(status, 1, 3, str.tostring(fresh30Count) + " | " + str.tostring(fresh15Count), text_color=color.aqua, bgcolor=color.new(color.black, 30))
    table.cell(status, 0, 4, "Fresh now 10m / 5m", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(status, 1, 4, str.tostring(fresh10Count) + " | " + str.tostring(fresh5Count), text_color=color.aqua, bgcolor=color.new(color.black, 30))
    table.cell(status, 0, 5, "Active 30m + 15m", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(status, 1, 5, str.tostring(primaryPairs), text_color=primaryPairs > 0 ? color.lime : color.gray, bgcolor=color.new(color.black, 30))
    table.cell(status, 0, 6, "Active 15m + 10m + 5m", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(status, 1, 6, str.tostring(fallbackTriples), text_color=fallbackTriples > 0 ? color.lime : color.gray, bgcolor=color.new(color.black, 30))
    table.cell(status, 0, 7, "Zones on chart", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(status, 1, 7, str.tostring(array.size(zoneBoxes)), text_color=color.aqua, bgcolor=color.new(color.black, 30))
    table.cell(status, 0, 8, "OB session filter", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(status, 1, 8, restrictToSessions ? "Tokyo / London / NY" : "OFF", text_color=restrictToSessions ? color.lime : color.orange, bgcolor=color.new(color.black, 30))
    table.cell(status, 0, 9, "FVG required", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(status, 1, 9, requireFVG ? "ON" : "OFF", text_color=requireFVG ? color.lime : color.orange, bgcolor=color.new(color.black, 30))
if barstate.islast and not showStatus
    table.clear(status, 0, 0, 1, 9)

alertcondition(newPrimary > 0, "New 30m + 15m OB zone", "A new 30m Order Block zone with 15m confirmation was drawn on {{ticker}}.")
alertcondition(newFallback > 0, "New 15m + 10m + 5m OB zone", "A new 15m Order Block zone with 10m and 5m confirmation plus 15m volume was drawn on {{ticker}}.")

// Notes:
// - Run on XAUUSD 30m. Lower timeframe arrays collect all 15m / 10m / 5m intrabars.
// - Session filter applies only to the OB source candle, not the impulse candle.
// - Volume is the current chart symbol's volume series (OANDA XAUUSD Tick Volume in the user's setup).
// - If zones are still missing, enable the Debug options to see which raw 30m / 15m
//   OBs are detected, then loosen "Impulse body / ATR", "Allowed distance" or FVG.
